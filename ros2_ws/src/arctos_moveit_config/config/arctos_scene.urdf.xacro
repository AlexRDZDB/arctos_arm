<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="arctos_scene">
    <xacro:arg name="initial_positions_file" default="initial_positions.yaml" />

    <!-- Import arctos_scene urdf file -->
    <xacro:include filename="$(find arctos_description)/urdf/arctos_scene.urdf.xacro" />

    <!-- Import control_xacro -->
    <xacro:include filename="arctos_scene.ros2_control.xacro" />


    <xacro:arctos_scene_ros2_control name="FakeSystem" initial_positions_file="$(arg initial_positions_file)"/>

</robot>
